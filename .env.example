# Backend (Spring Boot) — copy this file to .env or set these in your system
# environment / deployment platform. None of these are committed with real
# values — .env is already gitignored.

# Postgres connection string, e.g. jdbc:postgresql://localhost:5432/certitap_db
DB_URL=

# Postgres username (defaults to "postgres" if not set)
DB_USERNAME=postgres

# Postgres password
DB_PASSWORD=

# Real school registry endpoint used by /api/elements/fetch-external.
# Falls back to a placeholder if not set — ask a teammate for the real URL.
UITS_API_URL=
